# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — copy this file to .env and fill in your own values
# .env is gitignored and must NEVER be committed to source control
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite — VITE_ prefix exposes vars to the browser bundle) ─────────

# EmailJS — https://www.emailjs.com
# Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Email Services → Service ID
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
# Email Templates → contact notification template ID
VITE_EMAILJS_TEMPLATE_CONTACT=your_contact_template_id
# Email Templates → auto-reply template ID (sent to the user)
VITE_EMAILJS_TEMPLATE_REPLY=your_autoreply_template_id

# Google reCAPTCHA v2 — https://www.google.com/recaptcha
# Admin Console → Register site → Site Key
# Optional — contact form works without it (captcha bypassed if key is missing)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ── Backend (Netlify Functions — no VITE_ prefix, never sent to browser) ──────

# MongoDB Atlas connection string — https://cloud.mongodb.com
# Atlas → Connect → Drivers → copy the connection string, replace <password>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Database name — a new DB is created automatically on first connect
MONGODB_DATABASE=portfolio_cm

# Admin authentication
# Generate hash: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
# Or: node scripts/hash-password.js yourPassword
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
# Generate secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or: openssl rand -hex 32
ADMIN_JWT_SECRET=your_64_char_random_secret_here

# Cloudinary image hosting — https://cloudinary.com
# Dashboard → API Keys → copy Cloud name, API Key, API Secret
# Images are auto-converted to WebP and stored under portfolio_cm/projects/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Deploy (scripts/clear-cache.js — local use only, never on Netlify) ────────

# Netlify personal access token — https://app.netlify.com/user/applications
# New access token → copy and paste here
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
# Site ID — Netlify dashboard → your site → Site settings → General → Site ID
NETLIFY_SITE_ID=your_netlify_site_id
